{
  "name": "panguich",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src e2e scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node scripts/reset-demo-db.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "demo": "PANGUICH_DEMO_MODE=1 next build && PANGUICH_DEMO_MODE=1 next start",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
