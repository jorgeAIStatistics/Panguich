# Copy to .env.local. Nothing here is a real credential.

# Demo sign-in (pick-a-role, no password) is on in `next dev`. For a production
# build it stays OFF unless this is 1. Do not expose a demo-mode build publicly.
PANGUICH_DEMO_MODE=1

# Where the embedded demo database lives (PGlite = Postgres compiled to WASM).
# PANGUICH_DATA_DIR=.data/pglite

# Session signing key. If unset in demo mode, a random one is generated in .data/.
# SESSION_SECRET=

# Canonical origin used for metadata, sitemap and structured data.
# Leave unset locally. Do NOT point this at a live domain without owner approval.
# PANGUICH_SITE_URL=http://localhost:3000
